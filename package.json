{
  "name": "hhaexchange-smart-assistant",
  "description": "Enhanced HHAExchange user experience with auto-fill forms, intelligent call handling, real-time visit monitoring, and multi-tab data synchronization for healthcare coordinators",
  "version": "3.17.2",
  "author": {
    "name": "KurosakiRei",
    "email": "kurosakirei@outlook.com"
  },
  "scripts": {
    "format": "prettier -w ./",
    "analize": "cross-env npm_config_report=true npm run build",
    "build": "webpack --config config/webpack.config.prod.cjs",
    "dev": "webpack --config config/webpack.config.dev.cjs",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "bmad:refresh": "bmad-method install -f -i codex",
    "bmad:list": "bmad-method list:agents",
    "bmad:validate": "bmad-method validate"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KurosakiRei/HHAExchange-Smart-Assistant"
  },
  "private": true,
  "dependencies": {
    "@trim21/gm-fetch": "^0.3.0",
    "axios": "^1.7.8",
    "docxtemplater": "^3.68.4",
    "jquery": "^3.6.3",
    "naive-ui": "^2.40.2",
    "pizzip": "^3.2.0",
    "puppeteer-core": "^24.36.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --ignore-path ./.prettierignore --write "
    ]
  },
  "devDependencies": {
    "@types/greasemonkey": "^3.0.0",
    "@types/jquery": "^3.5.16",
    "@types/node": "^18.13.0",
    "browserslist": "^4.21.5",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.3",
    "husky": "^8.0.3",
    "less": "^4.1.3",
    "less-loader": "^11.1.0",
    "lint-staged": "^13.1.2",
    "postcss-loader": "^7.3.3",
    "prettier": "^2.8.4",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "userscript-metadata-webpack-plugin": "^0.2.12",
    "vue": "^3.3.4",
    "vue-loader": "^17.3.0",
    "webpack": "^5.75.0",
    "webpack-bundle-analyzer": "^4.8.0",
    "webpack-cli": "^5.0.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-merge": "^5.8.0",
    "webpack-sources": "^3.2.3"
  }
}
